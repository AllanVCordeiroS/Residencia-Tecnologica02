generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MÓDULO 1: EMPRESAS, UNIDADES E ACESSO
// ==========================================

model Empresa {
  id           String   @id @default(uuid()) @db.Uuid
  razaoSocial  String   @map("razao_social") @db.VarChar(150)
  nomeFantasia String   @map("nome_fantasia") @db.VarChar(120)
  cnpj         String   @unique @db.Char(14)
  email        String   @db.VarChar(150)
  telefone     String   @db.VarChar(20)
  status       String   @default("ATIVA") @db.VarChar(20)
  dataCadastro DateTime @default(now()) @map("data_cadastro") @db.Timestamptz

  unidades               Unidade[]
  usuarios               Usuario[]
  perfisAcesso           PerfilAcesso[]
  configuracaoFinanceira ConfiguracaoFinanceira?
  registrosAuditoria     RegistroAuditoria[]

  @@map("empresa")
}

model Unidade {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  nome      String  @db.VarChar(120)
  cnpj      String  @db.Char(14)
  endereco  String  @db.VarChar(200)
  cidade    String  @db.VarChar(100)
  estado    String  @db.Char(2)
  telefone  String? @db.VarChar(20)
  status    String  @default("ATIVA") @db.VarChar(20)

  empresa                Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuariosPrincipais     Usuario[]              @relation("UnidadePrincipal")
  usuariosAutorizados    UsuarioUnidade[]
  documentos             Documento[]
  tarefas                Tarefa[]
  centrosCusto           CentroCusto[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  registrosAuditoria     RegistroAuditoria[]

  @@unique([empresaId, cnpj])
  @@map("unidade")
}

model PerfilAcesso {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  nome      String  @db.VarChar(80)
  descricao String? @db.VarChar(255)

  empresa    Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuarios   Usuario[]
  permissoes PerfilPermissao[]

  @@unique([empresaId, nome])
  @@map("perfil_acesso")
}

model Permissao {
  id        String  @id @default(uuid()) @db.Uuid
  nome      String  @db.VarChar(80)
  descricao String? @db.VarChar(255)
  modulo    String  @db.VarChar(60)

  perfis PerfilPermissao[]

  @@unique([modulo, nome])
  @@map("permissao")
}

model PerfilPermissao {
  perfilAcessoId String   @map("perfil_acesso_id") @db.Uuid
  permissaoId    String   @map("permissao_id") @db.Uuid
  dataAtribuicao DateTime @default(now()) @map("data_atribuicao") @db.Timestamptz

  perfilAcesso PerfilAcesso @relation(fields: [perfilAcessoId], references: [id], onDelete: Cascade)
  permissao    Permissao    @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@id([perfilAcessoId, permissaoId])
  @@map("perfil_permissao")
}

model Usuario {
  id                 String    @id @default(uuid()) @db.Uuid
  empresaId          String    @map("empresa_id") @db.Uuid
  perfilAcessoId     String    @map("perfil_acesso_id") @db.Uuid
  unidadePrincipalId String?   @map("unidade_principal_id") @db.Uuid
  nome               String    @db.VarChar(150)
  email              String    @db.VarChar(150)
  senha              String    @db.VarChar(255)
  telefone           String?   @db.VarChar(20)
  status             String    @default("ATIVO") @db.VarChar(25)
  dataCadastro       DateTime  @default(now()) @map("data_cadastro") @db.Timestamptz
  ultimoAcesso       DateTime? @map("ultimo_acesso") @db.Timestamptz

  empresa                Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  perfilAcesso           PerfilAcesso            @relation(fields: [perfilAcessoId], references: [id], onDelete: Restrict)
  unidadePrincipal       Unidade?                @relation("UnidadePrincipal", fields: [unidadePrincipalId], references: [id], onDelete: SetNull)
  unidadesAutorizadas    UsuarioUnidade[]
  documentosResponsavel  Documento[]             @relation("DocumentoResponsavel")
  arquivosEnviados       DocumentoArquivo[]
  tarefasCriadas         Tarefa[]                @relation("TarefaCriador")
  tarefasAtribuidas      TarefaResponsavel[]
  checklistsConcluidos   TarefaChecklist[]
  lancamentosCriados     LancamentoFinanceiro[]
  preferenciaNotificacao PreferenciaNotificacao?
  notificacoes           Notificacao[]
  registrosAuditoria     RegistroAuditoria[]

  @@unique([empresaId, email])
  @@map("usuario")
}

model UsuarioUnidade {
  usuarioId      String   @map("usuario_id") @db.Uuid
  unidadeId      String   @map("unidade_id") @db.Uuid
  dataVinculacao DateTime @default(now()) @map("data_vinculacao") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@id([usuarioId, unidadeId])
  @@map("usuario_unidade")
}

// ==========================================
// MÓDULO 2: DOCUMENTOS E LICENÇAS
// ==========================================

model TipoDocumento {
  id            String  @id @default(uuid()) @db.Uuid
  nome          String  @unique @db.VarChar(100)
  descricao     String? @db.VarChar(255)
  exigeValidade Boolean @default(true) @map("exige_validade")
  status        String  @default("ATIVO") @db.VarChar(20)

  documentos Documento[]

  @@map("tipo_documento")
}

model Documento {
  id              String    @id @default(uuid()) @db.Uuid
  unidadeId       String    @map("unidade_id") @db.Uuid
  tipoDocumentoId String    @map("tipo_documento_id") @db.Uuid
  responsavelId   String?   @map("responsavel_id") @db.Uuid
  titulo          String    @db.VarChar(180)
  descricao       String?   @db.Text
  dataEmissao     DateTime  @map("data_emissao") @db.Date
  dataValidade    DateTime? @map("data_validade") @db.Date
  status          String    @default("PENDENTE") @db.VarChar(30)
  dataCadastro    DateTime  @default(now()) @map("data_cadastro") @db.Timestamptz

  unidade       Unidade            @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  tipoDocumento TipoDocumento      @relation(fields: [tipoDocumentoId], references: [id], onDelete: Restrict)
  responsavel   Usuario?           @relation("DocumentoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  arquivos      DocumentoArquivo[]
  alertas       DocumentoAlerta[]
  licenca       Licenca?

  @@index([unidadeId, status])
  @@map("documento")
}

model DocumentoArquivo {
  id                      String   @id @default(uuid()) @db.Uuid
  documentoId             String   @map("documento_id") @db.Uuid
  enviadoPorId            String   @map("enviado_por_id") @db.Uuid
  nomeArquivo             String   @map("nome_arquivo") @db.VarChar(255)
  referenciaArmazenamento String   @map("referencia_armazenamento") @db.Text
  tipoArquivo             String   @map("tipo_arquivo") @db.VarChar(100)
  tamanho                 BigInt
  hashSha256              String?  @map("hash_sha256") @db.Char(64)
  versao                  Int      @default(1)
  versaoAtual             Boolean  @default(true) @map("versao_atual")
  dataEnvio               DateTime @default(now()) @map("data_envio") @db.Timestamptz

  documento  Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  enviadoPor Usuario   @relation(fields: [enviadoPorId], references: [id], onDelete: Restrict)

  @@map("documento_arquivo")
}

model DocumentoAlerta {
  id          String   @id @default(uuid()) @db.Uuid
  documentoId String   @map("documento_id") @db.Uuid
  descricao   String   @db.VarChar(255)
  dataAlerta  DateTime @map("data_alerta") @db.Date
  status      String   @default("AGENDADO") @db.VarChar(20)
  tipoAlerta  String   @map("tipo_alerta") @db.VarChar(40)

  documento Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@map("documento_alerta")
}

model Licenca {
  id                  String  @id @default(uuid()) @db.Uuid
  documentoId         String  @unique @map("documento_id") @db.Uuid
  numero              String  @db.VarChar(80)
  orgaoEmissor        String  @map("orgao_emissor") @db.VarChar(150)
  categoriaGovernanca String  @map("categoria_governanca") @db.VarChar(120)
  responsavelTecnico  String  @map("responsavel_tecnico") @db.VarChar(150)
  bloqueioCautelar    Boolean @default(false) @map("bloqueio_cautelar")

  documento Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@map("licenca")
}

// ==========================================
// MÓDULO 3: GESTÃO DE TAREFAS
// ==========================================

model Tarefa {
  id            String    @id @default(uuid()) @db.Uuid
  unidadeId     String    @map("unidade_id") @db.Uuid
  criadorId     String    @map("criador_id") @db.Uuid
  titulo        String    @db.VarChar(100)
  descricao     String    @db.VarChar(500)
  prioridade    String    @db.VarChar(20)
  status        String    @default("A_FAZER") @db.VarChar(25)
  dataCriacao   DateTime  @default(now()) @map("data_criacao") @db.Timestamptz
  dataInicio    DateTime  @map("data_inicio") @db.Date
  prazo         DateTime  @db.Date
  dataConclusao DateTime? @map("data_conclusao") @db.Timestamptz

  unidade      Unidade             @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  criador      Usuario             @relation("TarefaCriador", fields: [criadorId], references: [id], onDelete: Restrict)
  responsaveis TarefaResponsavel[]
  subtarefas   TarefaSubtarefa[]
  checklist    TarefaChecklist[]
  arquivos     TarefaArquivo[]

  @@index([unidadeId, status])
  @@map("tarefa")
}

model TarefaResponsavel {
  tarefaId       String   @map("tarefa_id") @db.Uuid
  usuarioId      String   @map("usuario_id") @db.Uuid
  dataAtribuicao DateTime @default(now()) @map("data_atribuicao") @db.Timestamptz
  principal      Boolean  @default(false)

  tarefa  Tarefa  @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@id([tarefaId, usuarioId])
  @@map("tarefa_responsavel")
}

model TarefaSubtarefa {
  id        String    @id @default(uuid()) @db.Uuid
  tarefaId  String    @map("tarefa_id") @db.Uuid
  titulo    String    @db.VarChar(100)
  descricao String?   @db.VarChar(300)
  status    String    @default("PENDENTE") @db.VarChar(20)
  prazo     DateTime? @db.Date

  tarefa Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@map("tarefa_subtarefa")
}

model TarefaChecklist {
  id             String    @id @default(uuid()) @db.Uuid
  tarefaId       String    @map("tarefa_id") @db.Uuid
  concluidoPorId String?   @map("concluido_por_id") @db.Uuid
  descricao      String    @db.VarChar(150)
  status         String    @default("PENDENTE") @db.VarChar(20)
  ordem          Int
  dataConclusao  DateTime? @map("data_conclusao") @db.Timestamptz

  tarefa       Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  concluidoPor Usuario? @relation(fields: [concluidoPorId], references: [id], onDelete: SetNull)

  @@map("tarefa_checklist")
}

model TarefaArquivo {
  id                      String   @id @default(uuid()) @db.Uuid
  tarefaId                String   @map("tarefa_id") @db.Uuid
  nomeArquivo             String   @map("nome_arquivo") @db.VarChar(255)
  referenciaArmazenamento String   @map("referencia_armazenamento") @db.Text
  tipoArquivo             String   @map("tipo_arquivo") @db.VarChar(100)
  dataEnvio               DateTime @default(now()) @map("data_envio") @db.Timestamptz

  tarefa Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@map("tarefa_arquivo")
}

// ==========================================
// MÓDULO 4: GESTÃO FINANCEIRA
// ==========================================

model CategoriaFinanceira {
  id             String  @id @default(uuid()) @db.Uuid
  categoriaPaiId String? @map("categoria_pai_id") @db.Uuid
  nome           String  @db.VarChar(120)
  descricao      String? @db.VarChar(255)
  tipo           String  @db.VarChar(15)
  status         String  @default("ATIVA") @db.VarChar(20)

  categoriaPai  CategoriaFinanceira?   @relation("HierarquiaCategoria", fields: [categoriaPaiId], references: [id], onDelete: Restrict)
  subcategorias CategoriaFinanceira[]  @relation("HierarquiaCategoria")
  lancamentos   LancamentoFinanceiro[]

  @@map("categoria_financeira")
}

model CentroCusto {
  id        String  @id @default(uuid()) @db.Uuid
  unidadeId String  @map("unidade_id") @db.Uuid
  codigo    String  @db.VarChar(30)
  nome      String  @db.VarChar(120)
  descricao String? @db.VarChar(255)
  status    String  @default("ATIVO") @db.VarChar(20)

  unidade     Unidade                @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  lancamentos LancamentoFinanceiro[]

  @@unique([unidadeId, codigo])
  @@map("centro_custo")
}

model LancamentoFinanceiro {
  id             String    @id @default(uuid()) @db.Uuid
  unidadeId      String    @map("unidade_id") @db.Uuid
  categoriaId    String    @map("categoria_id") @db.Uuid
  centroCustoId  String?   @map("centro_custo_id") @db.Uuid
  criadoPorId    String    @map("criado_por_id") @db.Uuid
  descricao      String    @db.VarChar(200)
  valor          Decimal   @db.Decimal(14, 2)
  tipo           String    @db.VarChar(15)
  dataVencimento DateTime  @map("data_vencimento") @db.Date
  dataPagamento  DateTime? @map("data_pagamento") @db.Date
  status         String    @default("PENDENTE") @db.VarChar(25)
  dataCriacao    DateTime  @default(now()) @map("data_criacao") @db.Timestamptz

  unidade     Unidade             @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  categoria   CategoriaFinanceira @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  centroCusto CentroCusto?        @relation(fields: [centroCustoId], references: [id], onDelete: Restrict)
  criadoPor   Usuario             @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@index([unidadeId, status, dataVencimento])
  @@map("lancamento_financeiro")
}

model ConfiguracaoFinanceira {
  id                      String @id @default(uuid()) @db.Uuid
  empresaId               String @unique @map("empresa_id") @db.Uuid
  moedaPadrao             String @default("BRL") @map("moeda_padrao") @db.Char(3)
  configuracoesVencimento Json   @map("configuracoes_vencimento") @db.JsonB
  configuracoesCobranca   Json   @map("configuracoes_cobranca") @db.JsonB
  preferenciasFinanceiras Json?  @map("preferencias_financeiras") @db.JsonB

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("configuracao_financeira")
}

// ==========================================
// MÓDULO 5: NOTIFICAÇÕES (SISTEMA / IN-APP)
// ==========================================

model PreferenciaNotificacao {
  id                  String    @id @default(uuid()) @db.Uuid
  usuarioId           String    @unique @map("usuario_id") @db.Uuid
  canalSistemaAtivo   Boolean   @default(true) @map("canal_sistema_ativo")
  horarioPreferencial DateTime? @map("horario_preferencial") @db.Time
  diasEnvio           String?   @map("dias_envio") @db.VarChar(50)

  usuario Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  eventos PreferenciaEvento[]

  @@map("preferencia_notificacao")
}

model PreferenciaEvento {
  id                       String  @id @default(uuid()) @db.Uuid
  preferenciaNotificacaoId String  @map("preferencia_notificacao_id") @db.Uuid
  tipoEvento               String  @map("tipo_evento") @db.VarChar(80)
  frequencia               String  @default("IMEDIATO") @db.VarChar(30)
  ativo                    Boolean @default(true)

  preferenciaNotificacao PreferenciaNotificacao @relation(fields: [preferenciaNotificacaoId], references: [id], onDelete: Cascade)

  @@unique([preferenciaNotificacaoId, tipoEvento])
  @@map("preferencia_evento")
}

model Notificacao {
  id            String    @id @default(uuid()) @db.Uuid
  usuarioId     String    @map("usuario_id") @db.Uuid
  titulo        String    @db.VarChar(160)
  mensagem      String    @db.Text
  tipo          String    @db.VarChar(50)
  dataCriacao   DateTime  @default(now()) @map("data_criacao") @db.Timestamptz
  statusLeitura Boolean   @default(false) @map("status_leitura")
  lidaEm        DateTime? @map("lida_em") @db.Timestamptz

  usuario Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  envios  NotificacaoEnvio[]

  @@index([usuarioId, dataCriacao])
  @@map("notificacao")
}

model NotificacaoEnvio {
  id            String   @id @default(uuid()) @db.Uuid
  notificacaoId String   @map("notificacao_id") @db.Uuid
  canal         String   @default("SISTEMA") @db.VarChar(20)
  statusEnvio   String   @default("PENDENTE") @db.VarChar(20)
  tentativa     Int      @default(1)
  dataTentativa DateTime @default(now()) @map("data_tentativa") @db.Timestamptz
  mensagemErro  String?  @map("mensagem_erro") @db.Text

  notificacao Notificacao @relation(fields: [notificacaoId], references: [id], onDelete: Cascade)

  @@map("notificacao_envio")
}

// ==========================================
// MÓDULO 6: AUDITORIA
// ==========================================

model RegistroAuditoria {
  id                String   @id @default(uuid()) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  usuarioId         String?  @map("usuario_id") @db.Uuid
  unidadeId         String?  @map("unidade_id") @db.Uuid
  acaoRealizada     String   @map("acao_realizada") @db.VarChar(50)
  entidadeAfetada   String   @map("entidade_afetada") @db.VarChar(80)
  registroAfetadoId String?  @map("registro_afetado_id") @db.VarChar(80)
  descricao         String   @db.Text
  dataHora          DateTime @default(now()) @map("data_hora") @db.Timestamptz
  dadosAnteriores   Json?    @map("dados_anteriores") @db.JsonB
  dadosPosteriores  Json?    @map("dados_posteriores") @db.JsonB

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  unidade Unidade? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)

  @@index([empresaId, dataHora])
  @@map("registro_auditoria")
}
